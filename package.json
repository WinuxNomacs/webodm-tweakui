{
  "name": "webodm-tweakui-dev",
  "description": "Host-only tests, lint and browser checks for the plugin in tweakui/ (not part of the plugin zip)",
  "private": true,
  "scripts": {
    "test": "jest",
    "lint": "eslint",
    "screenshots": "node dev/screenshots.js",
    "selector-check": "node dev/selector-check.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "jest": {
    "roots": [
      "<rootDir>/tweakui/public",
      "<rootDir>/dev"
    ],
    "testEnvironment": "jsdom"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "playwright": "1.64.1",
    "vitepress": "1.6.4"
  }
}
